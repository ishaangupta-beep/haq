# ---- Bolna ----
# Dashboard → Developers → API key. Never commit the real value.
BOLNA_API_KEY=bn-xxxxxxxxxxxxxxxx
BOLNA_API_BASE=https://api.bolna.ai

# Agent IDs (open each agent; the ID is in the URL / settings)
BOLNA_INTAKE_AGENT_ID=
BOLNA_ADVOCATE_AGENT_ID=
BOLNA_CALLBACK_AGENT_ID=
BOLNA_MOCK_CARE_AGENT_ID=

# Optional: a Bolna number you own to call from (leave blank for Bolna's default)
BOLNA_FROM_NUMBER=

# ---- Supabase ----
SUPABASE_URL=https://xxxx.supabase.co
# Service role key: server-side only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# ---- Behaviour ----
# true = intake → advocate → callback run automatically after each call
AUTO_CHAIN=true

# DEMO: every advocate call goes to this number instead of the real helpline
# (e.g. the number the Mock – IndiGo Care agent answers on, or your own verified phone)
DEMO_COMPANY_NUMBER=

# Shared secret: add ?secret=<value> to the webhook URL you paste into Bolna
WEBHOOK_SECRET=change-me
